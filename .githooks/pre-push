#!/bin/sh
# Enable: git config core.hooksPath .githooks
# stdin: <local ref> <local sha> <remote ref> <remote sha> (unused; we check HEAD)
set -eu
hook_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
checks="$hook_dir/../checks"

"$checks/run-local.sh" --range

if [ "${RELAY_SKIP_PR_GUARDS:-}" = 1 ]; then
	exit 0
fi

# Label guard is fail-closed when a pull request exists.
# No pull request yet: label-guard notices and skips (CI still enforces).
# Approval is enforced by the trusted guards workflow, not this hook:
# a new commit cannot already have an APPROVED review on its SHA.
export RELAY_CHECK_MODE="${RELAY_CHECK_MODE:-hook}"
if [ -z "${RELAY_HEAD_SHA:-}" ]; then
	RELAY_HEAD_SHA=$(git rev-parse HEAD)
	export RELAY_HEAD_SHA
fi
"$checks/label-guard.sh"
